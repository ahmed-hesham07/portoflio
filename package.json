  "author": {
    "name": "Ahmed Hesham Ismail Seddik",
    "email": "ahmed.hesham0762@gmail.com"
  },
  "keywords": [
    "portfolio",
    "software-engineer",
    "data-scientist",
    "ai-engineer",
