# Portfolio Environment Configuration
# Copy this file to .env.local and fill in your actual values

# =================================
# EMAIL CONFIGURATION
# =================================
# Gmail credentials for SENDING emails (SMTP server)
# These are YOUR Gmail credentials that will send emails TO your primary email
GMAIL_USER=CHOOSE_YOUR_EMAIL
GMAIL_PASS=CHOOSE_YOUR_PASSWORD

# Primary email where contact form submissions will be RECEIVED
# This is automatically read from portfolio.json (Hello@ahmedseddik.tech)

# Alternative: Use other email services
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# =================================
# WEB3 CONFIGURATION (Optional)
# =================================
# Enable/disable Web3 wallet connection
NEXT_PUBLIC_WEB3_ENABLED=false

# WalletConnect Project ID (get from https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# =================================
# ANALYTICS (Optional)
# =================================
# Google Analytics tracking ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel Analytics (automatically enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# =================================
# FORM SERVICES (Alternative Options)
# =================================
# Formspree endpoint (alternative to custom email sending)
# FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# EmailJS configuration (client-side email sending)
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Resend API key (premium email service)
# RESEND_API_KEY=re_xxxxxxxxxx

# SendGrid API key (enterprise email service)
# SENDGRID_API_KEY=SG.xxxxxxxxxx

# =================================
# SECURITY & RATE LIMITING
# =================================
# Contact form rate limiting (requests per hour)
CONTACT_RATE_LIMIT=10

# Enable reCAPTCHA for contact form
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# =================================
# DEVELOPMENT & DEBUGGING
# =================================
# Enable detailed logging
DEBUG_EMAILS=true

# Skip email sending in development (just log)
SKIP_EMAIL_SEND=false

# =================================
# DOMAIN & DEPLOYMENT
# =================================
# Your domain (used for email templates and SEO)
NEXT_PUBLIC_DOMAIN=ahmedseddik.tech

# Deployment URL (for absolute URLs in emails)
NEXT_PUBLIC_SITE_URL=https://ahmedseddik.tech

# =================================
# DATABASE (If you add database later)
# =================================
# For storing contact submissions
# DATABASE_URL=postgresql://username:password@localhost:5432/portfolio
# MONGODB_URI=mongodb://localhost:27017/portfolio

# =================================
# MONITORING & ERROR TRACKING
# =================================
# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn

# LogRocket for user session recording
# LOGROCKET_APP_ID=your-logrocket-app-id
